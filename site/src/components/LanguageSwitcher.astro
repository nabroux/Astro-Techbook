---
import type { NoteLang } from '../types';
import { uiStrings } from '../lib/i18n';

interface LangOption {
  lang: NoteLang;
  href?: string;
  label?: string;
}

interface Props {
  current: NoteLang;
  options: LangOption[];
}

const { current, options } = Astro.props;
const strings = uiStrings[current];

const langLabel = (lang: NoteLang, label?: string) => {
  if (label) return label;
  if (lang === 'zh') return '中文';
  if (lang === 'en') return 'English';
  return lang.toUpperCase();
};
---
<div class="flex items-center gap-2 text-sm text-slate-200">
  <span class="text-xs uppercase tracking-[0.18em] text-slate-400">{strings.language}</span>
  <details class="group relative z-50">
    <summary class="flex cursor-pointer items-center gap-2 rounded-full bg-surface-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-accent-700 hover:text-white">
      {langLabel(current)}
      <svg class="h-3 w-3 text-slate-300 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 10.94l3.71-3.71a.75.75 0 0 1 1.08 1.04l-4.25 4.25a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"/>
      </svg>
    </summary>
    <div class="absolute right-0 z-60 mt-2 w-44 rounded-xl border border-surface-700/70 bg-surface-800/95 p-2 shadow-glow backdrop-blur">
      <ul class="space-y-1 text-xs">
        {options.map((opt) => (
          <li>
            {opt.href ? (
              <a
                href={opt.href}
                class={`flex items-center justify-between rounded-lg px-2 py-1.5 transition ${
                  opt.lang === current
                    ? 'bg-surface-700 text-white'
                    : 'text-slate-200 hover:bg-surface-700/70 hover:text-white'
                }`}
              >
                <span>{langLabel(opt.lang, opt.label)}</span>
                {opt.lang === current && <span class="text-accent-500">●</span>}
              </a>
            ) : (
              <span class="flex items-center justify-between rounded-lg px-2 py-1.5 text-slate-500">
                {langLabel(opt.lang, opt.label)}
                <span class="text-xs uppercase tracking-wide text-slate-500">N/A</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </details>
</div>
