---
import type { NavNode } from '../types';
import NavBranch from './NavBranch.astro';

interface Props {
  nav: NavNode[];
  heading: string;
  currentPath?: string;
}

const { nav = [], heading, currentPath } = Astro.props;
---
<aside class="w-full max-w-xs shrink-0 space-y-3 rounded-2xl glass-panel p-4">
  <div class="flex items-center justify-between text-sm font-semibold text-slate-200">
    <span>{heading}</span>
  </div>
  <nav class="pr-1">
    <ul class="space-y-1 text-slate-200">
      {nav.map((node) => (
        <NavBranch node={node} currentPath={currentPath} />
      ))}
    </ul>
  </nav>
</aside>
