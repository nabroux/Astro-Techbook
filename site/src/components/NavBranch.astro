---
import type { NavNode } from '../types';

interface Props {
  node: NavNode;
  currentPath?: string;
}

const { node, currentPath } = Astro.props;
const NavBranch = Astro.self;

const isActiveNote = (n: NavNode) =>
  currentPath && n.type === 'note' && currentPath === n.path;

const containsActive = (n: NavNode): boolean => {
  if (isActiveNote(n)) return true;
  if (n.type === 'folder' && n.children?.length) {
    return n.children.some((child) => containsActive(child));
  }
  return false;
};

const active = isActiveNote(node);
const isOpen = containsActive(node) || true;
---
{node.type === 'folder' ? (
  <li class="mb-1">
    <details class="nav-folder" open={isOpen}>
      <summary class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-slate-300 hover:bg-surface-700/50">
        <svg class="nav-caret h-3 w-3 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M6.293 3.293a1 1 0 0 1 1.414 0l6 6a1 1 0 0 1 0 1.414l-6 6A1 1 0 0 1 6 15.586L11.586 10 6 4.414a1 1 0 0 1 .293-1.121Z"
            clip-rule="evenodd"
          />
        </svg>
        <span class="inline-block h-1 w-1 rounded-full bg-accent-600"></span>
        <span class="select-none">{node.name}</span>
      </summary>
      {node.children && node.children.length > 0 && (
        <ul class="ml-3 border-l border-surface-600/70 pl-2">
          {node.children.map((child) => (
            <NavBranch node={child} currentPath={currentPath} />
          ))}
        </ul>
      )}
    </details>
  </li>
) : (
  <li>
    <a
      href={node.path}
      class={`block rounded-md px-2 py-1 text-sm transition-colors ${
        active
          ? 'bg-surface-700 text-white'
          : 'text-slate-300 hover:bg-surface-700/70 hover:text-white'
      }`}
    >
      {node.name}
    </a>
  </li>
)}
<style>
  details.nav-folder summary .nav-caret {
    transform: rotate(0deg);
    transition: transform 150ms ease;
  }
  details.nav-folder[open] > summary .nav-caret {
    transform: rotate(90deg);
  }
</style>
