---
interface SearchItem {
  label: string;
  path: string;
}

interface Props {
  items: SearchItem[];
  placeholder?: string;
}

const { items = [], placeholder = 'Search' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const rootId = `search-${uid}`;
const listId = `search-list-${uid}`;
---
<div id={rootId} class="relative w-full max-w-xs">
  <div class="absolute inset-y-0 left-3 flex items-center text-slate-400">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="6" />
      <path d="m20 20-3-3" />
    </svg>
  </div>
  <input
    id={`input-${uid}`}
    class="w-full rounded-xl border border-surface-600 bg-surface-700/80 py-2 pl-10 pr-3 text-sm text-slate-100 placeholder:text-slate-400 transition focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
    placeholder={placeholder}
    type="search"
  />
  <div
    class="absolute left-0 right-0 top-full z-50 mt-2 hidden max-h-80 overflow-auto rounded-xl border border-surface-600/80 bg-surface-800/95 shadow-xl backdrop-blur"
    data-suggestions
  ></div>
</div>
<script is:inline define:vars={{ items, rootId }}>
  (() => {
    const root = document.getElementById(rootId);
    if (!root) return;
    const input = root.querySelector('input');
    const suggestionBox = root.querySelector('[data-suggestions]');
    if (!input || !suggestionBox) return;

    const normalize = (str) =>
      (str || '')
        .toLowerCase()
        .replace(/[-_/]+/g, ' ')
        .replace(/\\s+/g, ' ')
        .trim();

    const itemsData = (Array.isArray(items) ? items : []).map((item) => ({
      ...item,
      searchKey: normalize(`${item.label} ${item.path}`)
    }));
    let currentMatches = [];

    const renderSuggestions = (value) => {
      const needle = normalize(value);
      currentMatches = itemsData
        .filter((item) => {
          return needle && item.searchKey.includes(needle);
        })
        .slice(0, 12);

      if (!needle || !currentMatches.length) {
        suggestionBox.classList.add('hidden');
        suggestionBox.innerHTML = '';
        return;
      }

      suggestionBox.innerHTML = currentMatches
        .map(
          (item) => `
            <button
              type="button"
              data-path="${item.path}"
              class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-100 hover:bg-surface-700/80"
            >
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent-500"></span>
              <span>${item.label}</span>
            </button>
          `
        )
        .join('');
      suggestionBox.classList.remove('hidden');
    };

    const navigate = (value) => {
      const needle = normalize(value);
      if (!needle) return;
      const match =
        currentMatches.find((item) => item.searchKey === needle) ||
        currentMatches[0] ||
        itemsData.find((item) => item.searchKey.includes(needle));
      if (match?.path) {
        window.location.href = match.path;
      }
    };

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        navigate(input.value);
      }
    });

    input.addEventListener('input', () => {
      renderSuggestions(input.value);
    });

    input.addEventListener('change', () => {
      navigate(input.value);
    });

    input.addEventListener('focus', () => {
      if (input.value) renderSuggestions(input.value);
    });

    suggestionBox.addEventListener('mousedown', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-path]');
      if (!button) return;
      const path = button.getAttribute('data-path');
      if (path) {
        window.location.href = path;
      }
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) {
        suggestionBox.classList.add('hidden');
      }
    });
  })();
</script>
