---
import type { NavNode, NoteLang } from '../types';
import '../styles/global.css';
import SidebarNav from '../components/SidebarNav.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import SearchBar from '../components/SearchBar.astro';
import { uiStrings } from '../lib/i18n';

interface Props {
  lang: NoteLang;
  nav: NavNode[];
  siteTitle: string;
  siteSubtitle?: string;
  social?: {
    github?: string;
    linkedin?: string;
    email?: string;
  };
  currentPath?: string;
  alternateUrl?: string;
  targetLang?: NoteLang;
  langOptions: { lang: NoteLang; href?: string; label?: string }[];
}

const {
  lang,
  nav,
  siteTitle,
  siteSubtitle,
  social,
  currentPath,
  langOptions
} = Astro.props;
const strings = uiStrings[lang];
const flattenNav = (nodes: NavNode[]): { label: string; path: string }[] => {
  const result: { label: string; path: string }[] = [];
  nodes.forEach((node) => {
    if (node.type === 'note') {
      result.push({ label: node.name, path: node.path });
    }
    if (node.children && node.children.length) {
      result.push(...flattenNav(node.children));
    }
  });
  return result;
};
const searchItems = flattenNav(nav);

const socialLinks = [
  {
    key: 'github',
    href: social?.github,
    label: 'GitHub',
    icon: `
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.58.1.79-.25.79-.55v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.3-1.28-1.65-1.28-1.65-1.05-.73.08-.71.08-.71 1.15.08 1.75 1.18 1.75 1.18 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.3 1.18-3.11-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18a10.8 10.8 0 0 1 5.74 0c2.19-1.49 3.14-1.18 3.14-1.18.63 1.59.24 2.77.12 3.06.74.81 1.17 1.85 1.17 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.07.78 2.16v3.2c0 .31.2.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
      </svg>
    `
  },
  {
    key: 'linkedin',
    href: social?.linkedin,
    label: 'LinkedIn',
    icon: `
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5.001 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zm7 0h3.8v1.64h.05c.53-1 1.82-2.06 3.74-2.06 4 0 4.74 2.63 4.74 6.05V21h-4v-4.78c0-1.14-.02-2.6-1.58-2.6-1.58 0-1.82 1.23-1.82 2.52V21h-4z"/>
      </svg>
    `
  },
  {
    key: 'email',
    href: social?.email ? `mailto:${social.email}` : undefined,
    label: 'Email',
    icon: `
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5zm2.4-.5 7.1 5.1 7.1-5.1zM19.5 7.2l-6.9 5a1 1 0 0 1-1.2 0l-6.9-5V18.5a.5.5 0 0 0 .5.5h15a.5.5 0 0 0 .5-.5z"/>
      </svg>
    `
  }
].filter((item) => item.href);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="https://api.iconify.design/twemoji/blue-book.svg" />
    <title>{siteTitle}</title>
  </head>
  <body>
    <div class="relative min-h-screen overflow-hidden px-4 py-6 sm:px-6 lg:px-10">
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-surface-800/60 via-transparent to-surface-800/20"></div>
      <div class="relative z-10 space-y-6">
        <header class="relative z-30 flex flex-wrap items-center gap-4 rounded-2xl border border-surface-700/80 bg-surface-800/80 px-5 py-4 backdrop-blur">
          <a href={`/${lang}`} class="group flex items-center gap-3 shrink-0">
            <div>
              <p class="text-xs uppercase tracking-[0.28em] text-slate-400 transition-colors group-hover:text-accent-500">
                {siteSubtitle}
              </p>
              <h1 class="text-2xl font-semibold text-white transition-colors group-hover:text-accent-500 sm:text-3xl">
                {siteTitle}
              </h1>
            </div>
          </a>
          <div class="flex flex-1 flex-wrap items-center justify-end gap-3">
            {searchItems.length > 0 && (
              <SearchBar items={searchItems} placeholder={strings.searchPlaceholder} />
            )}
            {socialLinks.length > 0 && (
              <div class="flex items-center gap-2 rounded-full bg-surface-700/60 px-2 py-1">
                {socialLinks.map((item) => (
                  <a
                    href={item.href}
                    class="flex items-center justify-center rounded-full bg-surface-600/60 p-2 text-slate-200 transition hover:bg-accent-700 hover:text-white"
                    aria-label={item.label}
                    rel="noreferrer"
                    target="_blank"
                    title={item.label}
                  >
                    <span class="block" set:html={item.icon}></span>
                  </a>
                ))}
              </div>
            )}
            <LanguageSwitcher current={lang} options={langOptions} />
          </div>
        </header>

        <div class="grid gap-5 lg:grid-cols-[300px,1fr]">
          <SidebarNav nav={nav} heading={strings.nav} currentPath={currentPath} />
          <main class="glass-panel rounded-3xl px-5 py-6 sm:px-8">
            <slot />
          </main>
        </div>
      </div>
    </div>
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
      mermaid.initialize({ startOnLoad: true, theme: "dark" });
    </script>
  </body>
</html>
